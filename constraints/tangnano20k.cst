// Tang Nano 20K pin constraints
// Device: GW2AR-LV18QN88C8/I7

IO_LOC  "clk" 4;            // 27 MHz onboard oscillator
// IO_PORT "clk" PULL_MODE=UP;

IO_LOC  "led[0]" 15;        // 6 onboard LEDs, active-low
IO_LOC  "led[1]" 16;
IO_LOC  "led[2]" 17;
IO_LOC  "led[3]" 18;
IO_LOC  "led[4]" 19;
IO_LOC  "led[5]" 20;

IO_LOC "rst" 88;
IO_LOC "uart_rx" 70;
IO_LOC "uart_tx" 69;

IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "rst" IO_TYPE=LVCMOS33;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

